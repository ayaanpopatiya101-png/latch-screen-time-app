{
  "expo": {
    "name": "Latch",
    "slug": "latch-screen-time",
    "scheme": "latch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6EFE2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.latch.screentime",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Latch sends gentle nudges from Lumi when it's time to focus or you've earned credits.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": ["group.com.latch.screentime"]
      }
    },
    "android": {
      "package": "com.latch.screentime",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F6EFE2"
      },
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "./modules/screen-time-ios/app.plugin",
      "./modules/screen-time-android/app.plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
